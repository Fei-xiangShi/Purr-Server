# 服务端运行环境；Compose 默认也是 production
PURR_ENVIRONMENT=production
# 服务端日志级别；生产环境建议 INFO，排障时临时改为 DEBUG
PURR_LOG_LEVEL=INFO

# Caddy 自动申请 TLS 证书使用的邮箱与三个公网域名；DNS 必须先指向部署主机
ACME_EMAIL=admin@your-domain.example
PURR_API_DOMAIN=api.your-domain.example
PURR_LIVEKIT_DOMAIN=livekit.your-domain.example
PURR_STORAGE_DOMAIN=storage.your-domain.example

# 下面这一行配置 PostgreSQL 使用的数据库名
POSTGRES_DB=purr
# 下面这一行配置 PostgreSQL 登录用户名
POSTGRES_USER=purr
# 下面这一行配置 PostgreSQL 登录密码，部署前必须改成你自己的强密码
POSTGRES_PASSWORD=change-me-postgres-password

# 下面这一行配置 Redis 密码，LiveKit、Egress 与 purr-server 必须保持一致
REDIS_PASSWORD=change-me-redis-password
# 每个来源在一个补充周期内可用的认证请求令牌数
PURR_RATE_LIMIT_LIMIT=10
# 认证限流令牌完全补充所需秒数
PURR_RATE_LIMIT_REFILL_PERIOD_SECONDS=60
# 事务型 Outbox 轮询间隔（毫秒）
PURR_OUTBOX_POLL_INTERVAL_MILLIS=100
# 每次 Outbox 分发领取的最大事件数
PURR_OUTBOX_BATCH_SIZE=100
# Outbox 事件租约时长（秒）
PURR_OUTBOX_LEASE_SECONDS=30
# Outbox 事件最大投递次数
PURR_OUTBOX_MAX_ATTEMPTS=10
# Outbox 首次重试延迟（秒）
PURR_OUTBOX_RETRY_BASE_SECONDS=1
# Outbox 指数退避最大延迟（秒）
PURR_OUTBOX_RETRY_MAX_SECONDS=300

# 登录刷新令牌有效期（秒）
PURR_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
PURR_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# 下面这一行配置 MinIO 管理员账号
MINIO_ROOT_USER=minioadmin
# 下面这一行配置 MinIO 管理员密码，部署前必须改成你自己的强密码
MINIO_ROOT_PASSWORD=change-me-minio-password
# 下面这一行配置录音文件写入的桶名
MINIO_BUCKET=purr-recordings
# 下面这一行配置 MinIO / S3 区域名，通常保留 us-east-1 即可
MINIO_REGION=us-east-1
# 手机访问录音文件使用的公网 S3/MinIO 端点；生产环境必须为 HTTPS
PURR_RECORDING_PUBLIC_ENDPOINT=https://storage.your-domain.example
# 录音下载链接有效期，允许范围 30-900 秒
PURR_RECORDING_DOWNLOAD_URL_TTL_SECONDS=300
# 展示给用户并写入审计记录的录音同意政策版本
PURR_RECORDING_CONSENT_POLICY_VERSION=2026-01
# 录音保留天数，到期后后台任务删除对象内容并保留审计元数据
PURR_RECORDING_RETENTION_DAYS=30
# 录音清理任务执行间隔（秒）
PURR_RECORDING_CLEANUP_INTERVAL_SECONDS=3600
# 每次录音清理的最大条数
PURR_RECORDING_CLEANUP_BATCH_SIZE=100
# 录音对象删除最大重试次数
PURR_RECORDING_CLEANUP_MAX_ATTEMPTS=10

# 下面这一行配置 LiveKit API Key，必须与 compose 里注入给 livekit / egress / purr-server 的值一致
LIVEKIT_API_KEY=devkey
# 下面这一行配置 LiveKit API Secret，必须与 compose 里注入给 livekit / egress / purr-server 的值一致
LIVEKIT_API_SECRET=devsecret
# 下面这一行配置服务器公网 IPv4，供 LiveKit 对外通告 RTC 地址
LIVEKIT_NODE_IP=YOUR_SERVER_PUBLIC_IP

# 下面这一行配置 purr-server 登录 JWT 的签名密钥，部署前必须改成随机长串
PURR_AUTH_JWT_SECRET=change-me-jwt-secret-use-a-random-value-32-bytes-minimum

# 下面这一行配置固定账号 A 的内部 userId
PURR_AUTH_USER_A_ID=user-a
# 下面这一行配置固定账号 A 的登录用户名
PURR_AUTH_USER_A_USERNAME=user-a
# 下面这一行配置固定账号 A 的显示名
PURR_AUTH_USER_A_DISPLAY_NAME=Purr Alpha
# 下面这一行配置固定账号 A 的头像 URL，可留空
PURR_AUTH_USER_A_AVATAR_URL=
# 下面这一行配置固定账号 A 的登录密码，部署前必须改成你自己的密码
PURR_AUTH_USER_A_PASSWORD=change-me-user-a-password

# 下面这一行配置固定账号 B 的内部 userId
PURR_AUTH_USER_B_ID=user-b
# 下面这一行配置固定账号 B 的登录用户名
PURR_AUTH_USER_B_USERNAME=user-b
# 下面这一行配置固定账号 B 的显示名
PURR_AUTH_USER_B_DISPLAY_NAME=Purr Beta
# 下面这一行配置固定账号 B 的头像 URL，可留空
PURR_AUTH_USER_B_AVATAR_URL=
# 下面这一行配置固定账号 B 的登录密码，部署前必须改成你自己的密码
PURR_AUTH_USER_B_PASSWORD=change-me-user-b-password

# 下面这一行配置固定配对的 pairId
PURR_PAIR_ID=pair-demo
# 下面这一行配置固定配对建立时间戳（毫秒）
PURR_PAIR_BONDED_AT_EPOCH_MILLIS=1735689600000
# 下面这一行配置配对中的 A 端 userId，必须与上面的 PURR_AUTH_USER_A_ID 一致
PURR_PAIR_USER_A_ID=user-a
# 下面这一行配置配对中的 B 端 userId，必须与上面的 PURR_AUTH_USER_B_ID 一致
PURR_PAIR_USER_B_ID=user-b

# 下面这一行配置返回给 Android 客户端的 LiveKit 公网 WebSocket 地址
# 单域名部署示例：wss://your-domain.example/livekit
PURR_LIVEKIT_WS_URL=wss://your-domain.example/livekit
