# Purr Server production environment
# Copy to .env, replace every change-me value, then run:
#   docker compose --env-file .env config -q
#   docker compose --env-file .env up -d --build

# Runtime and proxy domains. The three domains are also used to derive the
# public LiveKit WebSocket URL and the media (recording/avatar) endpoint.
PURR_LOG_LEVEL=INFO
ACME_EMAIL=admin@your-domain.example
PURR_API_DOMAIN=api.your-domain.example
PURR_LIVEKIT_DOMAIN=livekit.your-domain.example
PURR_STORAGE_DOMAIN=storage.your-domain.example

# Database and Redis credentials. Database name/user and all container-local
# connection URLs are fixed by compose.yaml and are not deployment inputs.
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# MinIO credentials. The bucket, region and internal endpoint are fixed by
# compose.yaml; only the credentials need to be supplied here.
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_RECORDING_ACCESS_KEY=purr-recording
MINIO_RECORDING_SECRET_KEY=change-me-recording-storage-secret
MINIO_AVATAR_ACCESS_KEY=purr-avatar
MINIO_AVATAR_SECRET_KEY=change-me-avatar-storage-secret

# LiveKit credentials and the host public IP used for WebRTC ICE candidates.
LIVEKIT_API_KEY=replace-with-random-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret
LIVEKIT_NODE_IP=YOUR_SERVER_PUBLIC_IP

# JWT signing key. Use a randomly generated value of at least 32 bytes.
PURR_AUTH_JWT_SECRET=change-me-jwt-secret-use-a-random-value-32-bytes-minimum

# Firebase Cloud Messaging. Create a least-privilege service account that can
# send FCM messages, keep the JSON file outside version control, and mount it
# read-only into the API container through compose.yaml.
PURR_PUSH_FCM_PROJECT_ID=your-firebase-project-id
PURR_PUSH_FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json

# Google Drive recording archive. Generate this authorized-user credential
# with :infrastructure:authorizeGoogleDrive and keep it outside version control.
PURR_GOOGLE_DRIVE_OAUTH_CREDENTIAL_FILE=./secrets/google-drive-oauth.json
PURR_GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id

# The two accounts are intentionally explicit: their IDs and credentials are
# stable identities, not values that should change on every startup.
PURR_AUTH_USER_A_ID=user-a
PURR_AUTH_USER_A_USERNAME=user-a
PURR_AUTH_USER_A_DISPLAY_NAME=Purr Alpha
PURR_AUTH_USER_A_AVATAR_URL=
PURR_AUTH_USER_A_PASSWORD=change-me-user-a-password

PURR_AUTH_USER_B_ID=user-b
PURR_AUTH_USER_B_USERNAME=user-b
PURR_AUTH_USER_B_DISPLAY_NAME=Purr Beta
PURR_AUTH_USER_B_AVATAR_URL=
PURR_AUTH_USER_B_PASSWORD=change-me-user-b-password

# Stable pair identity. Pair member IDs are derived from the two auth user IDs
# in compose.yaml, so they must not be configured a second time.
PURR_PAIR_ID=pair-demo
PURR_PAIR_BONDED_AT_EPOCH_MILLIS=1735689600000

# Optional operational tuning. Omit these lines to use the documented defaults
# in compose.yaml; they are kept configurable because they affect policy or
# workload rather than container wiring.
# Call reconciliation is enabled by default in production. Override only when
# changing the operational policy for a deployment.
# PURR_CALL_RECONCILIATION_ENABLED=true
# PURR_CALL_RECONCILIATION_INTERVAL_SECONDS=10
# PURR_CALL_RECONCILIATION_WAITING_TTL_SECONDS=120
# PURR_CALL_RECONCILIATION_EMPTY_ROOM_GRACE_SECONDS=15
# PURR_CALL_RECONCILIATION_BATCH_SIZE=100
# PURR_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# PURR_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# PURR_RECORDING_DOWNLOAD_URL_TTL_SECONDS=300
# PURR_RECORDING_CONSENT_POLICY_VERSION=2026-01
# PURR_RECORDING_RETENTION_DAYS=7
# PURR_RECORDING_CLEANUP_INTERVAL_SECONDS=3600
# PURR_RECORDING_CLEANUP_BATCH_SIZE=100
# PURR_RECORDING_CLEANUP_MAX_ATTEMPTS=10
# PURR_RECORDING_CLEANUP_HOUR=17
# PURR_RECORDING_CLEANUP_MINUTE=0
# PURR_RECORDING_CLEANUP_TIME_ZONE=Asia/Shanghai
# PURR_RECORDING_CLEANUP_LEASE_SECONDS=900
# PURR_GOOGLE_DRIVE_POLL_INTERVAL_MILLIS=1000
# PURR_GOOGLE_DRIVE_LEASE_SECONDS=3600
# PURR_GOOGLE_DRIVE_RETRY_BASE_SECONDS=5
# PURR_GOOGLE_DRIVE_RETRY_MAX_SECONDS=3600
# PURR_AVATAR_OUTPUT_SIZE_PIXELS=512
# PURR_AVATAR_MAX_SOURCE_DIMENSION_PIXELS=8192
# PURR_AVATAR_MAX_SOURCE_PIXELS=16000000
# PURR_AVATAR_JPEG_QUALITY_PERCENT=88
# PURR_AVATAR_MAX_OUTPUT_BYTES=1048576
# PURR_AVATAR_MAX_CONCURRENT_PROCESSING=2
# PURR_AVATAR_CLEANUP_INTERVAL_SECONDS=60
# PURR_AVATAR_CLEANUP_BATCH_SIZE=100
# Attempts before retries continue at the maximum interval; cleanup never abandons an object.
# PURR_AVATAR_CLEANUP_MAX_ATTEMPTS=20
# PURR_AVATAR_CLEANUP_RETRY_BASE_SECONDS=5
# PURR_AVATAR_CLEANUP_RETRY_MAX_SECONDS=3600
# PURR_AVATAR_ORPHAN_GRACE_SECONDS=3600
# PURR_OUTBOX_POLL_INTERVAL_MILLIS=100
# PURR_OUTBOX_BATCH_SIZE=100
# PURR_OUTBOX_LEASE_SECONDS=30
# PURR_OUTBOX_MAX_ATTEMPTS=10
# PURR_OUTBOX_RETRY_BASE_SECONDS=1
# PURR_OUTBOX_RETRY_MAX_SECONDS=300
# PURR_PUSH_MESSAGE_TTL_SECONDS=60
# PURR_RATE_LIMIT_LIMIT=10
# PURR_RATE_LIMIT_REFILL_PERIOD_SECONDS=60
